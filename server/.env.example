# Copy to server/.env for local development (it is git-ignored).
# On a host (Railway, Render, ...) set these as environment variables instead.

# MongoDB connection string. Defaults to mongodb://127.0.0.1:27017/trackify when unset.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>

# Secret used to sign login tokens. Required, e.g. `openssl rand -hex 32`.
JWT_SECRET=
