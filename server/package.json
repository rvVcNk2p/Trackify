{
  "name": "Trackify",
  "version": "1.0.0",
  "description": "Issue tracking system like JIRA and YouTrack.",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server",
    "server": "node --watch --env-file-if-exists=.env server",
    "client": "npm run dev --prefix ../client",
    "dev": "concurrently \"npm run server\" \"npm run client\""
  },
  "author": "Kussy Leo",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "config": "^3.3.12",
    "express": "^4.22.3",
    "express-validator": "^7.3.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.5"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^2.2.1"
  },
  "overrides": {
    "shell-quote": "^1.12.0"
  }
}
